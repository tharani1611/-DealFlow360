# ==============================================================================
# DealFlow360 — Production Environment Template (.env.example)
# ==============================================================================
# Copy this file to .env and configure real secret values for production deployment.
# NEVER commit .env files containing real passwords or API keys to source control.

# Application Core Configuration
APP_NAME=DealFlow360
APP_ENV=production
DEBUG=false
API_V1_STR=/api/v1
SECRET_KEY=REPLACE_WITH_SECURE_RANDOM_HEX_AT_LEAST_32_BYTES_LONG

# Server Binding
HOST=0.0.0.0
PORT=8000

# CORS & Host Whitelisting
# Format as JSON list of allowed origins or comma-separated strings
CORS_ORIGINS=["https://app.dealflow360.com", "https://dealflow360.com"]
ALLOWED_HOSTS=["app.dealflow360.com", "dealflow360.com", "backend", "localhost"]

# Managed PostgreSQL Database Connection
POSTGRES_SERVER=db.internal.dealflow360.com
POSTGRES_PORT=5432
POSTGRES_USER=dealflow_prod_user
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_DATABASE_PASSWORD
POSTGRES_DB=dealflow360_prod
DATABASE_URL=postgresql+asyncpg://dealflow_prod_user:REPLACE_WITH_STRONG_DATABASE_PASSWORD@db.internal.dealflow360.com:5432/dealflow360_prod

# JWT Authentication & Tokens
JWT_SECRET_KEY=REPLACE_WITH_DEDICATED_JWT_SECRET_MIN_32_BYTES
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=480

# Logging Configuration
LOG_LEVEL=INFO

# AI Intelligence Advisory Configuration
AI_ENABLED=true
AI_PROVIDER=gemini
GEMINI_API_KEY=REPLACE_WITH_SECURE_GEMINI_API_KEY
GEMINI_MODEL=gemini-1.5-flash
AI_MAX_OUTPUT_TOKENS=1000
AI_TEMPERATURE=0.2
AI_TIMEOUT_SECONDS=15.0
