# DealFlow360 Backend Environment Configuration Example
# Copy this file to .env for local development

# Application Configuration
APP_NAME=DealFlow360
APP_ENV=development
DEBUG=true
API_V1_STR=/api/v1
SECRET_KEY=CHANGE_THIS_IN_PRODUCTION_SECRET_KEY_MIN_32_BYTES_LONG

# Server Binding
HOST=0.0.1
PORT=8000

# Security & CORS
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]
ALLOWED_HOSTS=["localhost", "127.0.0.1"]

# Database Connection (PostgreSQL)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=dealflow_user
POSTGRES_PASSWORD=dealflow_password
POSTGRES_DB=dealflow360_db
DATABASE_URL=postgresql+asyncpg://dealflow_user:dealflow_password@localhost:5432/dealflow360_db

# JWT Security Configuration
JWT_SECRET_KEY=CHANGE_THIS_IN_PRODUCTION_JWT_SECRET_KEY_MIN_32_BYTES
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=480

# Logging
LOG_LEVEL=INFO

# AI Intelligence Configuration
AI_ENABLED=true
AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash
AI_MAX_OUTPUT_TOKENS=1000
AI_TEMPERATURE=0.2
AI_TIMEOUT_SECONDS=15.0
